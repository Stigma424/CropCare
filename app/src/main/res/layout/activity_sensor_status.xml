<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="20dp" android:background="@drawable/cc_zone_background">
  <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="20dp">
    <ImageButton android:id="@+id/btnBack" android:layout_width="48dp" android:layout_height="48dp" android:layout_alignParentStart="true" android:layout_centerVertical="true" android:background="@drawable/cc_avatar_circle" android:src="@drawable/ic_back" android:padding="13dp" android:contentDescription="Back" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerInParent="true" android:text="Sensor Status" android:textSize="20sp" android:textStyle="bold" android:textColor="#1E4D2B" android:fontFamily="@font/montserrat_family" />
    <ImageButton android:id="@+id/btnAddSensor" android:layout_width="48dp" android:layout_height="48dp" android:layout_alignParentEnd="true" android:layout_centerVertical="true" android:background="@drawable/cc_login_primary" android:src="@android:drawable/ic_input_add" android:padding="12dp" android:tint="@color/white" android:contentDescription="Add sensor" />
  </RelativeLayout>
  <TextView android:id="@+id/tvSensorListState" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="12dp" android:text="Loading sensors…" android:fontFamily="@font/montserrat_family" />
  <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvSensors" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginBottom="16dp" />
  <Button android:id="@+id/btnDeleteAll" android:layout_width="match_parent" android:layout_height="56dp" android:layout_gravity="center_horizontal" android:text="Delete All" android:backgroundTint="#1E4D2B" android:fontFamily="@font/montserrat_family" android:minHeight="48dp" android:textAllCaps="false" />
</LinearLayout>