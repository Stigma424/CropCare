<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <ImageButton android:id="@+id/btnBack" android:layout_width="48dp" android:layout_height="48dp" android:src="@android:drawable/ic_menu_revert" android:contentDescription="Back" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Subscription" android:textSize="24sp" android:textStyle="bold" />
        <TextView android:id="@+id/tvSubscriptionStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="16dp" android:text="Checking subscription…" android:textSize="18sp" />
        <TextView android:id="@+id/tvStatusDescription" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Loading your account status." />
        <LinearLayout android:id="@+id/layoutPayment" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="24dp" android:visibility="gone">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Already paid through verified project instructions? Submit your GCash receipt reference for manual review. Confirm payment instructions with the CropCare team before paying. Submission does not activate Pro. Never enter a PIN, OTP or password." />
            <EditText android:id="@+id/etGcashRef" android:layout_width="match_parent" android:layout_height="56dp" android:hint="GCash reference (8–20 digits)" android:inputType="number" android:maxLength="20" android:saveEnabled="false" />
            <Button android:id="@+id/btnSubscribe" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Submit for manual review" android:enabled="false" />
        </LinearLayout>
        <Button android:id="@+id/btnCancelSubscription" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Cancellation unavailable" android:visibility="gone" />
    </LinearLayout>
</ScrollView>
