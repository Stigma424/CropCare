<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="20dp" android:background="#EAEAEA">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="20dp" android:background="@drawable/cc_header" android:padding="8dp">
    <ImageButton android:id="@+id/btnBack" android:layout_width="48dp" android:layout_height="48dp" android:background="?attr/selectableItemBackgroundBorderless" android:src="@android:drawable/ic_menu_revert" android:contentDescription="Back" android:padding="13dp" />
    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Notifications" android:textSize="20sp" android:textStyle="bold" android:textColor="#FFFFFF" android:layout_marginStart="8dp" android:fontFamily="@font/montserrat_family" />
  </LinearLayout>
  <Button android:id="@+id/btnClearAll" android:layout_width="match_parent" android:layout_height="48dp" android:text="Clear all notifications" android:textColor="#B42318" android:backgroundTint="#FEE4E2" android:textAllCaps="false" android:layout_marginBottom="8dp" />
  <TextView android:id="@+id/tvEmptyNotif" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="No notifications or warnings received yet." android:gravity="center" android:textColor="#888888" android:textSize="14sp" android:layout_marginTop="8dp" android:visibility="gone" android:fontFamily="@font/montserrat_family" />
  <Button android:id="@+id/btnTestPush" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:text="Test phone notification" android:textAllCaps="false" />
  <Button android:id="@+id/btnRefreshNotifications" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Refresh" android:fontFamily="@font/montserrat_family" android:minHeight="48dp" android:textAllCaps="false" />
  <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvNotifications" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:paddingTop="12dp" android:paddingBottom="20dp" />
</LinearLayout>



