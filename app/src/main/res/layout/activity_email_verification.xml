<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_cropcare_login"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="top"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="94dp"
        android:paddingBottom="32dp">

        <!-- Verification title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Verification"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#176B2C"
            android:layout_marginBottom="20dp" />

        <!-- Verification instructions -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Please verify your email inbox and input the request code below"
            android:textSize="14sp"
            android:textColor="#858D85"
            android:lineSpacingExtra="2dp"
            android:layout_marginBottom="22dp" />

        <!-- Verification code input -->
        <EditText
            android:id="@+id/etCode"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:hint="Enter the code here"
            android:inputType="text"
            android:singleLine="true"
            android:textSize="14sp"
            android:textColor="#222222"
            android:textColorHint="#A0A0A0"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:background="@drawable/bg_register_input"
            android:elevation="2dp"
            android:layout_marginBottom="40dp" />

        <!-- Submit button -->
        <TextView
            android:id="@+id/btnSubmit"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="SUBMIT"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="11sp"
            android:letterSpacing="0.08"
            android:gravity="center"
            android:background="@drawable/bg_green_button"
            android:elevation="4dp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="14dp" />

        <!-- Cancel button -->
        <TextView
            android:id="@+id/btnCancel"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="CANCEL"
            android:textColor="#176B2C"
            android:textStyle="bold"
            android:textSize="11sp"
            android:letterSpacing="0.04"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>
</ScrollView>
