<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="#F8F9FA">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
    <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="24dp">
      <ImageButton android:id="@+id/btnBack" android:layout_width="48dp" android:layout_height="48dp" android:layout_alignParentStart="true" android:layout_centerVertical="true" android:background="?attr/selectableItemBackgroundBorderless" android:src="@android:drawable/ic_menu_revert" android:contentDescription="Back" android:padding="13dp" />
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerInParent="true" android:text="Pair CropCare Sensor" android:textColor="#1E4D2B" android:textSize="20sp" android:textStyle="bold" android:fontFamily="@font/montserrat_family" />
    </RelativeLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp" android:background="@drawable/bg_card" android:elevation="3dp">
      <ImageView android:layout_width="90dp" android:layout_height="90dp" android:layout_gravity="center_horizontal" android:src="@android:drawable/ic_menu_camera" android:contentDescription="QR Scanner" android:tint="@color/cc_primary" />
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center" android:text="Scan the QR code on your CropCare sensor" android:textColor="#1E4D2B" android:textSize="17sp" android:textStyle="bold" android:fontFamily="@font/montserrat_family" />
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:text="The QR code contains the device identity and its one-time registration code." android:textColor="#666666" android:textSize="13sp" android:fontFamily="@font/montserrat_family" />
      <Button android:id="@+id/btnScanQr" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="Scan QR Code" android:textAllCaps="false" android:backgroundTint="@color/cc_primary" android:fontFamily="@font/montserrat_family" android:minHeight="48dp" />
      <TextView android:id="@+id/tvQrStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center" android:text="No QR code scanned yet" android:textColor="#8A6500" android:textSize="13sp" android:fontFamily="@font/montserrat_family" />
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="Device ID" android:textColor="@color/cc_text" android:textStyle="bold" android:fontFamily="@font/montserrat_family" />
      <EditText android:id="@+id/etSensorId" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Scan QR to identify device" android:enabled="false" android:singleLine="true" android:textSize="14sp" android:fontFamily="@font/montserrat_family" android:background="@drawable/cc_input" android:textColor="@color/cc_text" android:textColorHint="@color/cc_muted" android:minHeight="52dp" android:paddingStart="16dp" android:paddingEnd="16dp" />
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Sensor Name" android:textColor="@color/cc_text" android:textStyle="bold" android:fontFamily="@font/montserrat_family" />
      <EditText android:id="@+id/etSensorName" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Example: Field A Soil Sensor" android:inputType="textCapWords" android:maxLength="80" android:fontFamily="@font/montserrat_family" android:background="@drawable/cc_input" android:textColor="@color/cc_text" android:textColorHint="@color/cc_muted" android:minHeight="52dp" android:paddingStart="16dp" android:paddingEnd="16dp" />
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Pairing creates the registration only. Sensor measurements will appear after the device begins transmitting." android:textColor="#666666" android:textSize="12sp" android:fontFamily="@font/montserrat_family" />
      <Button android:id="@+id/btnSave" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="Pair Sensor" android:textAllCaps="false" android:enabled="false" android:backgroundTint="#1E4D2B" android:fontFamily="@font/montserrat_family" android:minHeight="48dp" />
      <Button android:id="@+id/btnCancel" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Cancel" android:textAllCaps="false" android:fontFamily="@font/montserrat_family" android:minHeight="48dp" />
    </LinearLayout>
  </LinearLayout>
</ScrollView>