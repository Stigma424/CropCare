<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F2F2F2">


    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="CropCare"
                android:textColor="#1B5E20"
                android:textSize="36sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="24dp" />

            <!-- Profile Card  -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/loginbg_white_box"
                android:elevation="4dp"
                android:padding="16dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:src="@android:drawable/sym_def_app_icon"
                    app:tint="#1B5E20"
                    android:background="#E8F5E9"
                    android:padding="4dp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Good Morning, Rogelio"
                        android:textStyle="bold"
                        android:textColor="#1B5E20"
                        android:textSize="16sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Friday, April 17, 2026"
                        android:textColor="#757575"
                        android:textSize="13sp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Overall Soil Health Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/loginbg_white_box"
                android:elevation="4dp"
                android:padding="20dp"
                android:layout_marginBottom="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Overall Soil Health"
                    android:textStyle="bold"
                    android:textColor="#1B5E20"
                    android:textSize="18sp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="90%"
                    android:textSize="34sp"
                    android:textStyle="bold"
                    android:textColor="#1B5E20"
                    android:gravity="center"
                    android:layout_marginTop="12dp"/>
            </LinearLayout>

            <!-- Zones Header -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="My Zones"
                android:textStyle="bold"
                android:textSize="20sp"
                android:textColor="#1B5E20"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2 zones active"
                android:textSize="14sp"
                android:textColor="#757575"
                android:layout_marginBottom="16dp"/>

            <!-- Zones Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2"
                android:layout_marginBottom="16dp">

                <!-- ZONE 1 CARD -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:orientation="vertical"
                    android:background="@drawable/loginbg_white_box"
                    android:elevation="4dp"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Zone Mais 1"
                        android:textStyle="bold"
                        android:textColor="#1B5E20"
                        android:textSize="16sp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="refresh"
                        android:textColor="#1B5E20"
                        android:textStyle="bold"
                        android:textSize="10sp"
                        android:gravity="end"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="As of April 04, 2026\n10:00am"
                        android:textSize="10sp"
                        android:textColor="#757575"
                        android:layout_marginBottom="12dp"/>

                    <!-- N Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:text="N"
                            android:textColor="#FFF"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:background="@android:drawable/radiobutton_off_background"
                            android:backgroundTint="#D32F2F"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginStart="6dp">

                            <TextView
                                android:text="60 mg/kg"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:textColor="#333"/>

                            <TextView
                                android:text="Nitrogen"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="9sp"
                                android:textColor="#757575"/>
                        </LinearLayout>

                        <TextView
                            android:text="Normal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="9sp"
                            android:textColor="#1B5E20"
                            android:background="@android:drawable/radiobutton_off_background"
                            android:backgroundTint="#E8F5E9"
                            android:paddingStart="6dp"
                            android:paddingEnd="6dp"
                            android:paddingTop="2dp"
                            android:paddingBottom="2dp"/>
                    </LinearLayout>

                    <!-- P Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:text="P"
                            android:textColor="#FFF"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:background="@android:drawable/radiobutton_off_background"
                            android:backgroundTint="#2E7D32"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginStart="6dp">

                            <TextView
                                android:text="30 mg/kg"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:textColor="#333"/>

                            <TextView
                                android:text="Phosphorus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="9sp"
                                android:textColor="#757575"/>
                        </LinearLayout>

                        <TextView
                            android:text="Normal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="9sp"
                            android:textColor="#1B5E20"
                            android:background="@android:drawable/radiobutton_off_background"
                            android:backgroundTint="#E8F5E9"
                            android:paddingStart="6dp"
                            android:paddingEnd="6dp"
                            android:paddingTop="2dp"
                            android:paddingBottom="2dp"/>
                    </LinearLayout>

                    <!-- K Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:text="K"
                            android:textColor="#FFF"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:background="@android:drawable/radiobutton_off_background"
                            android:backgroundTint="#1976D2"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginStart="6dp">

                            <TextView
                                android:text="40 mg/kg"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:textColor="#333"/>

                            <TextView
                                android:text="Potassium"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="9sp"
                                android:textColor="#757575"/>
                        </LinearLayout>

                        <TextView
                            android:text="Normal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="9sp"
                            android:textColor="#1B5E20"
                            android:background="@android:drawable/radiobutton_off_background"
                            android:backgroundTint="#E8F5E9"
                            android:paddingStart="6dp"
                            android:paddingEnd="6dp"
                            android:paddingTop="2dp"
                            android:paddingBottom="2dp"/>
                    </LinearLayout>

                    <!-- ZONE 1 FOOTER -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/loginbg_white_box"
                        android:elevation="2dp"
                        android:padding="8dp"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:text="Normal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#1B5E20"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_gravity="center"/>

                        <TextView
                            android:text="Overall Soil Health"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#757575"
                            android:textSize="10sp"
                            android:layout_gravity="center"/>

                        <TextView
                            android:text="90%"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#1B5E20"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:layout_gravity="center"/>
                    </LinearLayout>

                    <TextView
                        android:text="view more..."
                        android:textColor="#1B5E20"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"/>
                </LinearLayout>

                <!-- ZONE 2 CARD -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:orientation="vertical"
                    android:background="@drawable/loginbg_white_box"
                    android:elevation="4dp"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Zone Mais 2"
                        android:textStyle="bold"
                        android:textColor="#1B5E20"
                        android:textSize="16sp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="refresh"
                        android:textColor="#1B5E20"
                        android:textStyle="bold"
                        android:textSize="10sp"
                        android:gravity="end"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="As of April 04, 2026\n10:00am"
                        android:textSize="10sp"
                        android:textColor="#757575"
                        android:layout_marginBottom="12dp"/>

                    <!-- N Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:text="N"
                            android:textColor="#FFF"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:background="@android:drawable/radiobutton_off_background"
                            android:backgroundTint="#D32F2F"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginStart="6dp">

                            <TextView
                                android:text="20 mg/kg"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:textColor="#333"/>

                            <TextView
                                android:text="Nitrogen"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="9sp"
                                android:textColor="#757575"/>
                        </LinearLayout>

                        <TextView
                            android:text="Low"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="9sp"
                            android:textColor="#D32F2F"
                            android:background="@android:drawable/radiobutton_off_background"
                            android:backgroundTint="#FFEBEE"
                            android:paddingStart="6dp"
                            android:paddingEnd="6dp"
                            android:paddingTop="2dp"
                            android:paddingBottom="2dp"/>
                    </LinearLayout>

                    <!-- P Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:text="P"
                            android:textColor="#FFF"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:background="@android:drawable/radiobutton_off_background"
                            android:backgroundTint="#2E7D32"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginStart="6dp">

                            <TextView
                                android:text="30 mg/kg"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:textColor="#333"/>

                            <TextView
                                android:text="Phosphorus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="9sp"
                                android:textColor="#757575"/>
                        </LinearLayout>

                        <TextView
                            android:text="Normal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="9sp"
                            android:textColor="#1B5E20"
                            android:background="@android:drawable/radiobutton_off_background"
                            android:backgroundTint="#E8F5E9"
                            android:paddingStart="6dp"
                            android:paddingEnd="6dp"
                            android:paddingTop="2dp"
                            android:paddingBottom="2dp"/>
                    </LinearLayout>

                    <!-- K Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:text="K"
                            android:textColor="#FFF"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:background="@android:drawable/radiobutton_off_background"
                            android:backgroundTint="#1976D2"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginStart="6dp">

                            <TextView
                                android:text="40 mg/kg"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:textColor="#333"/>

                            <TextView
                                android:text="Potassium"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="9sp"
                                android:textColor="#757575"/>
                        </LinearLayout>

                        <TextView
                            android:text="Normal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="9sp"
                            android:textColor="#1B5E20"
                            android:background="@android:drawable/radiobutton_off_background"
                            android:backgroundTint="#E8F5E9"
                            android:paddingStart="6dp"
                            android:paddingEnd="6dp"
                            android:paddingTop="2dp"
                            android:paddingBottom="2dp"/>
                    </LinearLayout>

                    <!-- ZONE 2 FOOTER -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/loginbg_white_box"
                        android:elevation="2dp"
                        android:padding="8dp"
                        android:layout_marginBottom="8dp">

                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="4dp"
                            android:layout_gravity="center_horizontal">

                            <TextView
                                android:text="⚠"
                                android:textColor="#F57C00"
                                android:textSize="16sp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>

                            <TextView
                                android:text="Warning"
                                android:textColor="#F57C00"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:layout_marginStart="4dp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>
                        </LinearLayout>

                        <TextView
                            android:text="Low and imong\nnitrogen"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#757575"
                            android:textSize="10sp"
                            android:layout_gravity="center_horizontal"/>
                    </LinearLayout>

                    <TextView
                        android:text="view more..."
                        android:textColor="#1B5E20"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"/>
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Floating Bottom Navigation Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="#F2F2F2">

        <LinearLayout
            android:id="@+id/bottomNavContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/nav_background"
            android:elevation="8dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:weightSum="4">

            <!-- Home -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_home"
                    app:tint="#1B5E20"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Home"
                    android:textSize="12sp"
                    android:textColor="#1B5E20"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

            <!-- Add Zone -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_add"
                    app:tint="#1B5E20"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Add Zone"
                    android:textSize="12sp"
                    android:textColor="#1B5E20"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

            <!-- Notif -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_notif"
                    app:tint="#1B5E20"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Notif"
                    android:textSize="12sp"
                    android:textColor="#1B5E20"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

            <!-- Settings -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_settings"
                    app:tint="#1B5E20"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Settings"
                    android:textSize="12sp"
                    android:textColor="#1B5E20"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

</LinearLayout>