<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/cc_canvas" android:fillViewport="true">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
    <!-- title -->
    <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="4dp">
      <ImageButton android:id="@+id/btnBack" android:layout_width="48dp" android:layout_height="48dp" android:layout_alignParentStart="true" android:layout_centerVertical="true" android:src="@android:drawable/ic_menu_revert" app:tint="#000000" android:padding="13dp" android:contentDescription="Back" />
      <TextView android:id="@+id/tvSensorDetailTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerInParent="true" android:text="Sensor 1" android:textColor="#1E4D2B" android:textSize="20sp" android:textStyle="bold" android:fontFamily="@font/montserrat_family" />
      <LinearLayout android:id="@+id/btnRefreshDetail" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:layout_centerVertical="true" android:gravity="center_vertical" android:clickable="true" android:focusable="true" android:orientation="horizontal">
        <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@android:drawable/ic_popup_sync" app:tint="#1E4D2B" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:text="refresh" android:textColor="#1E4D2B" android:textSize="12sp" android:textStyle="bold" android:fontFamily="@font/montserrat_family" />
      </LinearLayout>
    </RelativeLayout>
    <TextView android:id="@+id/tvAssignedZone" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/montserrat_family" />
    <TextView android:id="@+id/tvLastUpdated" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="16dp" android:text="Waiting for current readings" android:textColor="#666666" android:textSize="12sp" android:fontFamily="@font/montserrat_family" />
    <TextView android:id="@+id/btnViewAllHistory" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" android:background="@drawable/bg_history_pill" android:clickable="true" android:focusable="true" android:gravity="center" android:minHeight="46dp" android:padding="10dp" android:text="View Complete Sensor History" android:textColor="#1B6936" android:textSize="15sp" android:textStyle="bold" android:fontFamily="@font/montserrat_family" />
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/cc_zone_card" android:elevation="2dp" android:padding="20dp" android:layout_marginBottom="16dp">
        <TextView android:textSize="16sp" android:textStyle="bold" android:layout_marginBottom="14dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="NPK readings" android:textColor="@color/cc_text" android:fontFamily="@font/montserrat_family" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="60dp" android:gravity="center_vertical" android:background="@drawable/cc_zone_row" android:paddingHorizontal="12dp" android:layout_marginBottom="10dp">
          <TextView android:layout_width="32dp" android:gravity="center" android:textColor="#D96554" android:textSize="21sp" android:textStyle="bold" android:layout_height="wrap_content" android:text="N" android:fontFamily="@font/montserrat_family" />
          <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="12dp">
            <TextView android:textSize="10sp" android:textColor="@color/cc_muted" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Nitrogen" android:fontFamily="@font/montserrat_family" />
            <TextView android:textSize="17sp" android:textStyle="bold" android:id="@+id/tvSensorN" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="—" android:textColor="@color/cc_text" android:fontFamily="@font/montserrat_family" />
          </LinearLayout>
          <TextView android:layout_width="wrap_content" android:textSize="10sp" android:textColor="@color/cc_primary" android:background="@drawable/cc_badge" android:paddingHorizontal="8dp" android:paddingVertical="5dp" android:id="@+id/tvStatusN" android:layout_height="wrap_content" android:text="No data" android:fontFamily="@font/montserrat_family" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="60dp" android:gravity="center_vertical" android:background="@drawable/cc_zone_row" android:paddingHorizontal="12dp" android:layout_marginBottom="10dp">
          <TextView android:layout_width="32dp" android:gravity="center" android:textColor="#4F905E" android:textSize="21sp" android:textStyle="bold" android:layout_height="wrap_content" android:text="P" android:fontFamily="@font/montserrat_family" />
          <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="12dp">
            <TextView android:textSize="10sp" android:textColor="@color/cc_muted" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Phosphorus" android:fontFamily="@font/montserrat_family" />
            <TextView android:textSize="17sp" android:textStyle="bold" android:id="@+id/tvSensorP" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="—" android:textColor="@color/cc_text" android:fontFamily="@font/montserrat_family" />
          </LinearLayout>
          <TextView android:layout_width="wrap_content" android:textSize="10sp" android:textColor="@color/cc_primary" android:background="@drawable/cc_badge" android:paddingHorizontal="8dp" android:paddingVertical="5dp" android:id="@+id/tvStatusP" android:layout_height="wrap_content" android:text="No data" android:fontFamily="@font/montserrat_family" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="60dp" android:gravity="center_vertical" android:background="@drawable/cc_zone_row" android:paddingHorizontal="12dp" android:layout_marginBottom="10dp">
          <TextView android:layout_width="32dp" android:gravity="center" android:textColor="#5597B4" android:textSize="21sp" android:textStyle="bold" android:layout_height="wrap_content" android:text="K" android:fontFamily="@font/montserrat_family" />
          <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="12dp">
            <TextView android:textSize="10sp" android:textColor="@color/cc_muted" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Potassium" android:fontFamily="@font/montserrat_family" />
            <TextView android:textSize="17sp" android:textStyle="bold" android:id="@+id/tvSensorK" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="—" android:textColor="@color/cc_text" android:fontFamily="@font/montserrat_family" />
          </LinearLayout>
          <TextView android:layout_width="wrap_content" android:textSize="10sp" android:textColor="@color/cc_primary" android:background="@drawable/cc_badge" android:paddingHorizontal="8dp" android:paddingVertical="5dp" android:id="@+id/tvStatusK" android:layout_height="wrap_content" android:text="No data" android:fontFamily="@font/montserrat_family" />
        </LinearLayout>
      </LinearLayout>
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/cc_zone_card" android:elevation="2dp" android:padding="20dp" android:layout_marginBottom="16dp">
        <TextView android:textSize="16sp" android:textStyle="bold" android:layout_marginBottom="14dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Other details" android:textColor="@color/cc_text" android:fontFamily="@font/montserrat_family" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
          <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/cc_zone_row" android:padding="14dp" android:layout_margin="4dp">
            <TextView android:textSize="11sp" android:textColor="@color/cc_muted" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Moisture" android:fontFamily="@font/montserrat_family" />
            <TextView android:textSize="20sp" android:textStyle="bold" android:layout_marginTop="8dp" android:id="@+id/tvSensorMoisture" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="—" android:textColor="@color/cc_text" android:fontFamily="@font/montserrat_family" />
            <TextView android:textSize="10sp" android:textColor="@color/cc_muted" android:layout_marginTop="6dp" android:id="@+id/tvStatusMoisture" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="No data" android:fontFamily="@font/montserrat_family" />
          </LinearLayout>
          <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/cc_zone_row" android:padding="14dp" android:layout_margin="4dp">
            <TextView android:textSize="11sp" android:textColor="@color/cc_muted" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="pH level" android:fontFamily="@font/montserrat_family" />
            <TextView android:textSize="20sp" android:textStyle="bold" android:layout_marginTop="8dp" android:id="@+id/tvSensorPh" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="—" android:textColor="@color/cc_text" android:fontFamily="@font/montserrat_family" />
            <TextView android:textSize="10sp" android:textColor="@color/cc_muted" android:layout_marginTop="6dp" android:id="@+id/tvStatusPh" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="No data" android:fontFamily="@font/montserrat_family" />
          </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
          <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/cc_zone_row" android:padding="14dp" android:layout_margin="4dp">
            <TextView android:textSize="11sp" android:textColor="@color/cc_muted" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Temperature" android:fontFamily="@font/montserrat_family" />
            <TextView android:textSize="20sp" android:textStyle="bold" android:layout_marginTop="8dp" android:id="@+id/tvSensorTemp" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="—" android:textColor="@color/cc_text" android:fontFamily="@font/montserrat_family" />
            <TextView android:textSize="10sp" android:textColor="@color/cc_muted" android:layout_marginTop="6dp" android:id="@+id/tvStatusTemp" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="No data" android:fontFamily="@font/montserrat_family" />
          </LinearLayout>
          <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/cc_zone_row" android:padding="14dp" android:layout_margin="4dp">
            <TextView android:textSize="11sp" android:textColor="@color/cc_muted" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Electrical conductivity" android:fontFamily="@font/montserrat_family" />
            <TextView android:textSize="20sp" android:textStyle="bold" android:layout_marginTop="8dp" android:id="@+id/tvSensorEc" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="—" android:textColor="@color/cc_text" android:fontFamily="@font/montserrat_family" />
            <TextView android:textSize="10sp" android:textColor="@color/cc_muted" android:layout_marginTop="6dp" android:id="@+id/tvStatusEc" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="No data" android:fontFamily="@font/montserrat_family" />
          </LinearLayout>
        </LinearLayout>
      </LinearLayout>
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/cc_zone_card" android:elevation="2dp" android:padding="20dp" android:layout_marginBottom="16dp">
        <TextView android:textSize="16sp" android:textStyle="bold" android:layout_marginBottom="14dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Soil health" android:textColor="@color/cc_text" android:fontFamily="@font/montserrat_family" />
        <TextView android:textSize="18sp" android:textStyle="bold" android:textColor="@color/cc_primary" android:id="@+id/tvSensorSoilHealth" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Awaiting assessment" android:fontFamily="@font/montserrat_family" />
        <TextView android:textSize="11sp" android:textColor="@color/cc_muted" android:layout_marginTop="10dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Based on the latest usable reading from this sensor." android:fontFamily="@font/montserrat_family" />
      </LinearLayout>
    <LinearLayout
      android:id="@+id/sensorRecommendations"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="16dp"
      android:background="@drawable/cc_zone_card"
      android:orientation="vertical"
      android:padding="16dp">
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Soil recommendations" android:textSize="18sp" android:textStyle="bold"
        android:fontFamily="@font/montserrat_family" />
      <LinearLayout android:id="@+id/sensorAdviceCards" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="vertical" />
      <Button android:id="@+id/btnSensorAdviceDetails" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="View more details" android:textAllCaps="false" android:visibility="gone" />
      <Button android:id="@+id/btnSensorDemoPlan" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="Demo Subscription" android:visibility="gone" />
    </LinearLayout>
  </LinearLayout>
</ScrollView>
