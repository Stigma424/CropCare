<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/cc_auth_background" android:fillViewport="true">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp" android:gravity="top">
    <ImageView android:id="@+id/btnBack" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_back" android:padding="13dp" app:tint="@color/cc_primary" android:contentDescription="Back" android:clickable="true" android:focusable="true" android:layout_marginBottom="16dp" />
    <TextView android:textSize="27sp" android:textStyle="bold" android:textColor="@color/cc_primary_dark" android:layout_marginBottom="8dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Set a new password" android:fontFamily="@font/montserrat_family" />
    <TextView android:textColor="@color/cc_muted" android:lineSpacingExtra="4dp" android:layout_marginBottom="24dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Use a password you haven’t used before." android:textSize="14sp" android:fontFamily="@font/montserrat_family" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/cc_card" android:padding="22dp">
      <TextView android:textSize="12sp" android:textStyle="bold" android:layout_marginBottom="8dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="New password" android:textColor="@color/cc_text" android:fontFamily="@font/montserrat_family" />
      <EditText android:id="@+id/etNewPassword" android:layout_width="match_parent" android:layout_height="56dp" android:background="@drawable/cc_input" android:paddingHorizontal="16dp" android:textSize="14sp" android:textColor="@color/cc_text" android:textColorHint="@color/cc_muted" android:hint="8–128 characters" android:inputType="textPassword" android:layout_marginBottom="12dp" android:saveEnabled="false" android:fontFamily="@font/montserrat_family" android:minHeight="52dp" android:paddingStart="16dp" android:paddingEnd="16dp" />
      <TextView android:textSize="12sp" android:textStyle="bold" android:layout_marginBottom="8dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Confirm new password" android:textColor="@color/cc_text" android:fontFamily="@font/montserrat_family" />
      <EditText android:id="@+id/etConfirmNewPassword" android:layout_width="match_parent" android:layout_height="56dp" android:background="@drawable/cc_input" android:paddingHorizontal="16dp" android:textSize="14sp" android:textColor="@color/cc_text" android:textColorHint="@color/cc_muted" android:hint="Re-enter your password" android:inputType="textPassword" android:layout_marginBottom="12dp" android:saveEnabled="false" android:fontFamily="@font/montserrat_family" android:minHeight="52dp" android:paddingStart="16dp" android:paddingEnd="16dp" />
      <Button android:id="@+id/btnSavePassword" android:layout_width="match_parent" android:layout_height="52dp" android:gravity="center" android:text="Save new password" android:textSize="14sp" android:textStyle="bold" android:textAllCaps="false" android:textColor="@color/white" android:background="@drawable/bg_login_button" android:clickable="true" android:focusable="true" android:layout_marginTop="8dp" android:layout_marginBottom="8dp" android:fontFamily="@font/montserrat_family" android:minHeight="48dp" />
    </LinearLayout>
  </LinearLayout>
</ScrollView>