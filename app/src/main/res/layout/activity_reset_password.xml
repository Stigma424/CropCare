<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_cropcare_login"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="top"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="94dp"
        android:paddingBottom="32dp">

        <!-- Reset Password title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Reset Password"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#176B2C"
            android:layout_marginBottom="20dp" />

        <!-- Reset Password instructions -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Your identity was verified! Set your new password."
            android:textSize="14sp"
            android:textColor="#858D85"
            android:lineSpacingExtra="2dp"
            android:layout_marginBottom="32dp" />

        <!-- New Password input -->

        <!-- Confirm New Password input -->
        <EditText
            android:id="@+id/etNewPassword"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_register_input"
            android:elevation="2dp"
            android:gravity="center_vertical"
            android:hint="Enter your new password"
            android:inputType="textPassword"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:singleLine="true"
            android:textColor="#222222"
            android:textColorHint="#A0A0A0"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/etConfirmNewPassword"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:hint="Confirm your new password"
            android:inputType="textPassword"
            android:singleLine="true"
            android:textSize="12sp"
            android:textColor="#222222"
            android:textColorHint="#A0A0A0"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:background="@drawable/bg_register_input"
            android:elevation="2dp" />

        <!-- Save Password button -->
        <Button
            android:id="@+id/btnSavePassword"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="38dp"
            android:background="@drawable/bg_green_button"
            android:backgroundTint="@null"
            android:text="SAVE NEW PASSWORD"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="11sp"
            android:letterSpacing="0.08"
            android:textAllCaps="false"
            android:elevation="4dp"
            android:stateListAnimator="@null" />


        <!-- Cancel section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:orientation="horizontal">

            <!-- Original ImageView ID preserved -->
            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:padding="12dp"
                android:src="@drawable/backbutton"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Go back" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CANCEL"
                android:textColor="#176B2C"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

        </LinearLayout>


    </LinearLayout>
</ScrollView>
