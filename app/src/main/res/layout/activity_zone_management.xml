<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/cc_zone_background" android:fillViewport="true">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@android:color/transparent" android:padding="24dp">
      <TextView android:textColor="#718B86" android:textSize="10sp" android:letterSpacing="0.16" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ZONE MANAGEMENT" android:fontFamily="@font/montserrat_family" />
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:layout_marginTop="10dp">
        <TextView android:layout_width="0dp" android:layout_weight="1" android:textSize="24sp" android:textStyle="bold" android:textColor="@color/cc_primary" android:id="@+id/tvManageZoneName" android:layout_height="wrap_content" android:text="Your zone" android:fontFamily="@font/montserrat_family" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnRefresh" style="@style/Widget.Material3.Button.TextButton" android:layout_width="48dp" android:layout_height="48dp" android:text="↻" android:textSize="24sp" android:textColor="@color/cc_primary" android:minWidth="0dp" android:padding="0dp" android:contentDescription="Refresh zone" android:fontFamily="@font/montserrat_family" android:minHeight="48dp" android:textAllCaps="false" />
      </LinearLayout>
      <TextView android:textSize="11sp" android:textColor="#718B86" android:layout_marginTop="10dp" android:id="@+id/tvLastUpdated" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Waiting for readings" android:fontFamily="@font/montserrat_family" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/cc_zone_card" android:elevation="2dp" android:padding="20dp" android:layout_marginBottom="16dp">
        <TextView android:textSize="16sp" android:textStyle="bold" android:layout_marginBottom="14dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Corn age" android:textColor="@color/cc_text" android:fontFamily="@font/montserrat_family" />
        <TextView android:textSize="14sp" android:id="@+id/tvCornAge" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Loading planting details…" android:textColor="@color/cc_text" android:fontFamily="@font/montserrat_family" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnNewCornPlanted" android:layout_width="match_parent" android:layout_height="52dp" android:visibility="gone" android:text="Start a new planting cycle" android:layout_marginTop="12dp" android:fontFamily="@font/montserrat_family" android:minHeight="48dp" android:textAllCaps="false" />
      </LinearLayout>
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/cc_zone_card" android:elevation="2dp" android:padding="20dp" android:layout_marginBottom="16dp">
        <TextView android:textSize="16sp" android:textStyle="bold" android:layout_marginBottom="14dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="NPK readings" android:textColor="@color/cc_text" android:fontFamily="@font/montserrat_family" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="60dp" android:gravity="center_vertical" android:background="@drawable/cc_zone_row" android:paddingHorizontal="12dp" android:layout_marginBottom="10dp">
          <TextView android:layout_width="32dp" android:gravity="center" android:textColor="#D96554" android:textSize="21sp" android:textStyle="bold" android:layout_height="wrap_content" android:text="N" android:fontFamily="@font/montserrat_family" />
          <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="12dp">
            <TextView android:textSize="10sp" android:textColor="@color/cc_muted" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Nitrogen" android:fontFamily="@font/montserrat_family" />
            <TextView android:textSize="17sp" android:textStyle="bold" android:id="@+id/tvAvgN" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="—" android:textColor="@color/cc_text" android:fontFamily="@font/montserrat_family" />
          </LinearLayout>
          <TextView android:layout_width="wrap_content" android:textSize="10sp" android:textColor="@color/cc_primary" android:background="@drawable/cc_badge" android:paddingHorizontal="8dp" android:paddingVertical="5dp" android:id="@+id/tvStatusN" android:layout_height="wrap_content" android:text="No data" android:fontFamily="@font/montserrat_family" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="60dp" android:gravity="center_vertical" android:background="@drawable/cc_zone_row" android:paddingHorizontal="12dp" android:layout_marginBottom="10dp">
          <TextView android:layout_width="32dp" android:gravity="center" android:textColor="#4F905E" android:textSize="21sp" android:textStyle="bold" android:layout_height="wrap_content" android:text="P" android:fontFamily="@font/montserrat_family" />
          <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="12dp">
            <TextView android:textSize="10sp" android:textColor="@color/cc_muted" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Phosphorus" android:fontFamily="@font/montserrat_family" />
            <TextView android:textSize="17sp" android:textStyle="bold" android:id="@+id/tvAvgP" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="—" android:textColor="@color/cc_text" android:fontFamily="@font/montserrat_family" />
          </LinearLayout>
          <TextView android:layout_width="wrap_content" android:textSize="10sp" android:textColor="@color/cc_primary" android:background="@drawable/cc_badge" android:paddingHorizontal="8dp" android:paddingVertical="5dp" android:id="@+id/tvStatusP" android:layout_height="wrap_content" android:text="No data" android:fontFamily="@font/montserrat_family" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="60dp" android:gravity="center_vertical" android:background="@drawable/cc_zone_row" android:paddingHorizontal="12dp" android:layout_marginBottom="10dp">
          <TextView android:layout_width="32dp" android:gravity="center" android:textColor="#5597B4" android:textSize="21sp" android:textStyle="bold" android:layout_height="wrap_content" android:text="K" android:fontFamily="@font/montserrat_family" />
          <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="12dp">
            <TextView android:textSize="10sp" android:textColor="@color/cc_muted" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Potassium" android:fontFamily="@font/montserrat_family" />
            <TextView android:textSize="17sp" android:textStyle="bold" android:id="@+id/tvAvgK" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="—" android:textColor="@color/cc_text" android:fontFamily="@font/montserrat_family" />
          </LinearLayout>
          <TextView android:layout_width="wrap_content" android:textSize="10sp" android:textColor="@color/cc_primary" android:background="@drawable/cc_badge" android:paddingHorizontal="8dp" android:paddingVertical="5dp" android:id="@+id/tvStatusK" android:layout_height="wrap_content" android:text="No data" android:fontFamily="@font/montserrat_family" />
        </LinearLayout>
      </LinearLayout>
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/cc_zone_card" android:elevation="2dp" android:padding="20dp" android:layout_marginBottom="16dp">
        <TextView android:textSize="16sp" android:textStyle="bold" android:layout_marginBottom="14dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Other details" android:textColor="@color/cc_text" android:fontFamily="@font/montserrat_family" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
          <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/cc_zone_row" android:padding="14dp" android:layout_margin="4dp">
            <TextView android:textSize="11sp" android:textColor="@color/cc_muted" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Moisture" android:fontFamily="@font/montserrat_family" />
            <TextView android:textSize="20sp" android:textStyle="bold" android:layout_marginTop="8dp" android:id="@+id/tvAvgMoisture" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="—" android:textColor="@color/cc_text" android:fontFamily="@font/montserrat_family" />
            <TextView android:textSize="10sp" android:textColor="@color/cc_muted" android:layout_marginTop="6dp" android:id="@+id/tvStatusMoisture" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="No data" android:fontFamily="@font/montserrat_family" />
          </LinearLayout>
          <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/cc_zone_row" android:padding="14dp" android:layout_margin="4dp">
            <TextView android:textSize="11sp" android:textColor="@color/cc_muted" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="pH level" android:fontFamily="@font/montserrat_family" />
            <TextView android:textSize="20sp" android:textStyle="bold" android:layout_marginTop="8dp" android:id="@+id/tvAvgPh" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="—" android:textColor="@color/cc_text" android:fontFamily="@font/montserrat_family" />
            <TextView android:textSize="10sp" android:textColor="@color/cc_muted" android:layout_marginTop="6dp" android:id="@+id/tvStatusPh" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="No data" android:fontFamily="@font/montserrat_family" />
          </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
          <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/cc_zone_row" android:padding="14dp" android:layout_margin="4dp">
            <TextView android:textSize="11sp" android:textColor="@color/cc_muted" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Temperature" android:fontFamily="@font/montserrat_family" />
            <TextView android:textSize="20sp" android:textStyle="bold" android:layout_marginTop="8dp" android:id="@+id/tvAvgTemp" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="—" android:textColor="@color/cc_text" android:fontFamily="@font/montserrat_family" />
            <TextView android:textSize="10sp" android:textColor="@color/cc_muted" android:layout_marginTop="6dp" android:id="@+id/tvStatusTemp" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="No data" android:fontFamily="@font/montserrat_family" />
          </LinearLayout>
          <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/cc_zone_row" android:padding="14dp" android:layout_margin="4dp">
            <TextView android:textSize="11sp" android:textColor="@color/cc_muted" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="EC" android:fontFamily="@font/montserrat_family" />
            <TextView android:textSize="20sp" android:textStyle="bold" android:layout_marginTop="8dp" android:id="@+id/tvAvgEc" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="—" android:textColor="@color/cc_text" android:fontFamily="@font/montserrat_family" />
            <TextView android:textSize="10sp" android:textColor="@color/cc_muted" android:layout_marginTop="6dp" android:id="@+id/tvStatusEc" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="No data" android:fontFamily="@font/montserrat_family" />
          </LinearLayout>
        </LinearLayout>
      </LinearLayout>
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/cc_zone_card" android:elevation="2dp" android:padding="20dp" android:layout_marginBottom="16dp">
        <TextView android:textSize="16sp" android:textStyle="bold" android:layout_marginBottom="14dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Soil health" android:textColor="@color/cc_text" android:fontFamily="@font/montserrat_family" />
        <TextView android:textSize="18sp" android:textStyle="bold" android:textColor="@color/cc_primary" android:id="@+id/tvSoilHealth" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Awaiting assessment" android:fontFamily="@font/montserrat_family" />
        <TextView android:textSize="11sp" android:textColor="@color/cc_muted" android:layout_marginTop="10dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Based on your latest usable soil readings." android:fontFamily="@font/montserrat_family" />
      </LinearLayout>
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/cc_zone_card" android:elevation="2dp" android:padding="20dp" android:layout_marginBottom="16dp">
        <TextView android:textSize="16sp" android:textStyle="bold" android:layout_marginBottom="14dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Recommendations" android:textColor="@color/cc_text" android:fontFamily="@font/montserrat_family" />
        <TextView android:background="@drawable/cc_notice" android:padding="14dp" android:lineSpacingExtra="4dp" android:id="@+id/tvRecommendationText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Loading current recommendation…" android:textSize="14sp" android:textColor="@color/cc_text" android:fontFamily="@font/montserrat_family" />
        <LinearLayout android:id="@+id/recommendationSummaryCards" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnSeeMoreRec" android:layout_width="match_parent" android:layout_height="52dp" android:text="View more details" android:textAllCaps="false" android:layout_marginTop="8dp" android:fontFamily="@font/montserrat_family" android:minHeight="48dp" />
      </LinearLayout>
      <com.google.android.material.button.MaterialButton android:id="@+id/btnSensorStatus" android:layout_width="match_parent" android:layout_height="52dp" android:text="Sensor status" android:textAllCaps="false" android:layout_marginTop="8dp" android:fontFamily="@font/montserrat_family" android:minHeight="48dp" />
      <com.google.android.material.button.MaterialButton android:id="@+id/btnEditZone" android:layout_width="match_parent" android:layout_height="52dp" android:text="Edit zone details" android:textAllCaps="false" android:layout_marginTop="8dp" app:backgroundTint="@color/cc_soft_green" android:textColor="@color/cc_primary" android:fontFamily="@font/montserrat_family" android:minHeight="48dp" />
      <com.google.android.material.button.MaterialButton android:id="@+id/btnHarvest" android:layout_width="match_parent" android:layout_height="52dp" android:text="Mark harvested" android:textAllCaps="false" android:layout_marginTop="8dp" app:backgroundTint="@color/cc_accent" android:textColor="@color/cc_primary_dark" android:fontFamily="@font/montserrat_family" android:minHeight="48dp" />
      <com.google.android.material.button.MaterialButton android:id="@+id/btnDeleteZone" android:layout_width="match_parent" android:layout_height="52dp" android:text="Delete zone" android:textAllCaps="false" android:layout_marginTop="8dp" app:backgroundTint="@color/cc_surface" android:textColor="#A24535" app:strokeColor="#E4C7C0" app:strokeWidth="1dp" android:fontFamily="@font/montserrat_family" android:minHeight="48dp" />
      <com.google.android.material.button.MaterialButton android:id="@+id/btnBack" android:layout_width="match_parent" android:layout_height="52dp" android:text="Back to my zones" android:textAllCaps="false" android:layout_marginTop="8dp" app:backgroundTint="@color/cc_soft_green" android:textColor="@color/cc_primary" android:fontFamily="@font/montserrat_family" android:minHeight="48dp" />
    </LinearLayout>
  </LinearLayout>
</ScrollView>
