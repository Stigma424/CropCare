<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/cc_card" android:padding="18dp" android:elevation="3dp" android:layout_marginHorizontal="2dp" android:layout_marginBottom="16dp">
  <TextView android:visibility="gone" android:background="@drawable/cc_notice" android:padding="12dp" android:layout_marginBottom="12dp" android:textSize="12sp" android:id="@+id/tvAlert" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textColor="@color/cc_text" android:fontFamily="@font/montserrat_family" />
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
    <TextView android:layout_width="0dp" android:layout_weight="1" android:textSize="18sp" android:textStyle="bold" android:id="@+id/tvZoneName" android:layout_height="wrap_content" android:text="Zone" android:textColor="@color/cc_text" android:fontFamily="@font/montserrat_family" />
    <TextView android:layout_width="64dp" android:layout_height="48dp" android:gravity="center" android:textSize="11sp" android:textColor="@color/cc_primary" android:contentDescription="Refresh zone readings" android:clickable="true" android:focusable="true" android:id="@+id/tvRefresh" android:text="Refresh" android:fontFamily="@font/montserrat_family" />
  </LinearLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
    <TextView android:layout_width="wrap_content" android:textSize="10sp" android:textColor="@color/cc_muted" android:id="@+id/tvDate" android:layout_height="wrap_content" android:text="No readings yet" android:fontFamily="@font/montserrat_family" />
    <TextView android:layout_width="wrap_content" android:layout_marginStart="8dp" android:textSize="10sp" android:textColor="@color/cc_muted" android:id="@+id/tvTime" android:layout_height="wrap_content" android:text="" android:fontFamily="@font/montserrat_family" />
  </LinearLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:gravity="center_vertical" android:background="@drawable/cc_row" android:paddingHorizontal="12dp" android:layout_marginTop="10dp">
    <TextView android:layout_width="28dp" android:layout_height="28dp" android:gravity="center" android:text="N" android:textColor="@color/cc_text" android:textStyle="bold" android:textSize="16sp" android:fontFamily="@font/montserrat_family" />
    <TextView android:layout_width="0dp" android:layout_weight="1" android:gravity="center" android:textStyle="bold" android:id="@+id/tvN" android:layout_height="wrap_content" android:text="—" android:textColor="@color/cc_text" android:textSize="14sp" android:fontFamily="@font/montserrat_family" />
    <TextView android:layout_width="wrap_content" android:textSize="10sp" android:textColor="@color/cc_primary" android:background="@drawable/cc_badge" android:paddingHorizontal="8dp" android:paddingVertical="5dp" android:id="@+id/tvStatusN" android:layout_height="wrap_content" android:text="No data" android:fontFamily="@font/montserrat_family" />
  </LinearLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:gravity="center_vertical" android:background="@drawable/cc_row" android:paddingHorizontal="12dp" android:layout_marginTop="10dp">
    <TextView android:layout_width="28dp" android:layout_height="28dp" android:gravity="center" android:text="P" android:textColor="@color/cc_text" android:textStyle="bold" android:textSize="16sp" android:fontFamily="@font/montserrat_family" />
    <TextView android:layout_width="0dp" android:layout_weight="1" android:gravity="center" android:textStyle="bold" android:id="@+id/tvP" android:layout_height="wrap_content" android:text="—" android:textColor="@color/cc_text" android:textSize="14sp" android:fontFamily="@font/montserrat_family" />
    <TextView android:layout_width="wrap_content" android:textSize="10sp" android:textColor="@color/cc_primary" android:background="@drawable/cc_badge" android:paddingHorizontal="8dp" android:paddingVertical="5dp" android:id="@+id/tvStatusP" android:layout_height="wrap_content" android:text="No data" android:fontFamily="@font/montserrat_family" />
  </LinearLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:gravity="center_vertical" android:background="@drawable/cc_row" android:paddingHorizontal="12dp" android:layout_marginTop="10dp">
    <TextView android:layout_width="28dp" android:layout_height="28dp" android:gravity="center" android:text="K" android:textColor="@color/cc_text" android:textStyle="bold" android:textSize="16sp" android:fontFamily="@font/montserrat_family" />
    <TextView android:layout_width="0dp" android:layout_weight="1" android:gravity="center" android:textStyle="bold" android:id="@+id/tvK" android:layout_height="wrap_content" android:text="—" android:textColor="@color/cc_text" android:textSize="14sp" android:fontFamily="@font/montserrat_family" />
    <TextView android:layout_width="wrap_content" android:textSize="10sp" android:textColor="@color/cc_primary" android:background="@drawable/cc_badge" android:paddingHorizontal="8dp" android:paddingVertical="5dp" android:id="@+id/tvStatusK" android:layout_height="wrap_content" android:text="No data" android:fontFamily="@font/montserrat_family" />
  </LinearLayout>
  <LinearLayout android:id="@+id/soilHealthBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="16dp">
    <TextView android:textSize="11sp" android:textColor="@color/cc_muted" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Overall soil health · provisional" android:fontFamily="@font/montserrat_family" />
    <TextView android:textSize="20sp" android:textStyle="bold" android:textColor="@color/cc_primary" android:layout_marginTop="4dp" android:id="@+id/tvSoilHealth" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="—" android:fontFamily="@font/montserrat_family" />
    <TextView android:textSize="11sp" android:textColor="@color/cc_muted" android:layout_marginTop="4dp" android:id="@+id/tvHealthStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:fontFamily="@font/montserrat_family" />
    <TextView android:layout_marginTop="12dp" android:minHeight="48dp" android:gravity="center" android:background="@drawable/cc_soft_button" android:textColor="@color/cc_primary" android:textStyle="bold" android:clickable="true" android:focusable="true" android:id="@+id/btnViewMore" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="View more  ›" android:textSize="14sp" android:fontFamily="@font/montserrat_family" />
  </LinearLayout>
</LinearLayout>