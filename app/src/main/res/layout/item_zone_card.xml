<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp" android:layout_marginHorizontal="2dp" android:layout_marginBottom="16dp" android:background="@drawable/cc_card" android:elevation="4dp">
    <TextView android:id="@+id/tvAlert" android:layout_width="match_parent" android:textColor="#BB2100" android:background="@drawable/cc_notice" android:padding="10dp" android:layout_marginBottom="12dp" android:visibility="gone" android:layout_height="wrap_content" android:text="" android:textSize="14sp" android:fontFamily="@font/montserrat" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/tvZoneName" android:layout_width="0dp" android:layout_weight="1" android:textStyle="bold" android:textSize="19sp" android:layout_height="wrap_content" android:text="Zone" android:textColor="#151915" android:fontFamily="@font/montserrat" />
        <ImageView android:layout_width="11dp" android:layout_height="11dp" android:src="@drawable/cc_refresh" android:contentDescription="@null" />
        <TextView android:id="@+id/tvRefresh" android:minHeight="48dp" android:gravity="center" android:paddingHorizontal="6dp" android:textSize="11sp" android:textColor="#056E09" android:clickable="true" android:focusable="true" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Refresh" android:fontFamily="@font/montserrat" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:id="@+id/tvDate" android:textSize="10sp" android:textColor="#747A74" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="No readings yet" android:fontFamily="@font/montserrat" />
        <TextView android:id="@+id/tvTime" android:layout_marginStart="10dp" android:textSize="10sp" android:textColor="#747A74" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:fontFamily="@font/montserrat" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="36dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="12dp" android:background="@drawable/cc_row" android:layout_marginTop="9dp">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="N" android:textColor="#151915" android:textSize="17sp" android:layout_weight="1" android:fontFamily="@font/montserrat" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="—" android:textColor="#151915" android:textSize="16sp" android:id="@+id/tvN" android:layout_weight="3" android:gravity="center" android:fontFamily="@font/montserrat" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="No data" android:textColor="#056E09" android:textSize="10sp" android:id="@+id/tvStatusN" android:background="@drawable/cc_badge" android:paddingHorizontal="12dp" android:paddingVertical="5dp" android:fontFamily="@font/montserrat" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="36dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="12dp" android:background="@drawable/cc_row" android:layout_marginTop="9dp">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="P" android:textColor="#151915" android:textSize="17sp" android:layout_weight="1" android:fontFamily="@font/montserrat" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="—" android:textColor="#151915" android:textSize="16sp" android:id="@+id/tvP" android:layout_weight="3" android:gravity="center" android:fontFamily="@font/montserrat" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="No data" android:textColor="#056E09" android:textSize="10sp" android:id="@+id/tvStatusP" android:background="@drawable/cc_badge" android:paddingHorizontal="12dp" android:paddingVertical="5dp" android:fontFamily="@font/montserrat" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="36dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="12dp" android:background="@drawable/cc_row" android:layout_marginTop="9dp">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="K" android:textColor="#151915" android:textSize="17sp" android:layout_weight="1" android:fontFamily="@font/montserrat" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="—" android:textColor="#151915" android:textSize="16sp" android:id="@+id/tvK" android:layout_weight="3" android:gravity="center" android:fontFamily="@font/montserrat" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="No data" android:textColor="#056E09" android:textSize="10sp" android:id="@+id/tvStatusK" android:background="@drawable/cc_badge" android:paddingHorizontal="12dp" android:paddingVertical="5dp" android:fontFamily="@font/montserrat" />
    </LinearLayout>
    <LinearLayout android:id="@+id/soilHealthBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="12dp">
        <TextView android:textSize="14sp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Overall Soil Health" android:textColor="#151915" android:fontFamily="@font/montserrat" />
        <TextView android:id="@+id/tvSoilHealth" android:layout_marginStart="6dp" android:layout_width="0dp" android:layout_weight="1" android:textColor="#626662" android:layout_height="wrap_content" android:text="—" android:textSize="14sp" android:fontFamily="@font/montserrat" />
        <TextView android:id="@+id/btnViewMore" android:minHeight="48dp" android:gravity="center" android:textSize="11sp" android:textColor="#056E09" android:clickable="true" android:focusable="true" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="View more ›" android:fontFamily="@font/montserrat" />
    </LinearLayout>
    <TextView android:id="@+id/tvHealthStatus" android:textSize="11sp" android:textColor="#747A74" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:fontFamily="@font/montserrat" />
</LinearLayout>