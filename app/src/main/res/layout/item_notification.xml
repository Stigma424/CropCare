<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:background="@drawable/cc_card" android:elevation="4dp" android:layout_marginBottom="18dp">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
    <TextView android:id="@+id/tvNotifTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Warning: Low Nitrogen" android:textStyle="bold" android:textSize="15sp" android:textColor="#17231B" android:fontFamily="@font/montserrat_family" />
    <TextView android:id="@+id/tvNotifTime" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="10:30 AM" android:textSize="10sp" android:textColor="#777777" android:fontFamily="@font/montserrat_family" />
  </LinearLayout>
  <TextView android:id="@+id/tvNotifBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Open the zone to review its readings and recommended next steps." android:textSize="13sp" android:textColor="@color/cc_text" android:layout_marginTop="8dp" android:fontFamily="@font/montserrat_family" />
</LinearLayout>

