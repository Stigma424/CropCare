<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#EAEAEA">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp" android:background="@drawable/cc_header">
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical">
      <ImageView android:id="@+id/btnBack" android:layout_width="48dp" android:layout_height="48dp" android:padding="13dp" android:src="@drawable/ic_back" app:tint="@color/white" android:contentDescription="Back" android:clickable="true" android:focusable="true" />
      <TextView android:textSize="21sp" android:textStyle="bold" android:textColor="@color/white" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Settings" android:fontFamily="@font/montserrat_family" android:gravity="center" android:paddingEnd="48dp" />
    </LinearLayout>
    <TextView android:textSize="12sp" android:textColor="#E3EFDD" android:paddingStart="48dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Your account and preferences" android:fontFamily="@font/montserrat_family" />
  </LinearLayout>
  <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal" android:background="@drawable/cc_card" android:padding="24dp" android:layout_marginBottom="20dp" android:elevation="2dp">
        <ImageView android:layout_width="64dp" android:layout_height="64dp" android:src="@drawable/ic_account" android:background="@drawable/cc_avatar_circle" android:padding="12dp" app:tint="@color/cc_primary" android:contentDescription="Profile" />
        <TextView android:gravity="center" android:textSize="20sp" android:textStyle="bold" android:layout_marginTop="12dp" android:id="@+id/tvProfileName" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Your profile" android:textColor="@color/cc_text" android:fontFamily="@font/montserrat_family" />
        <TextView android:gravity="center" android:textSize="12sp" android:textColor="@color/cc_muted" android:layout_marginTop="6dp" android:id="@+id/tvProfileEmail" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Loading account…" android:fontFamily="@font/montserrat_family" />
        <TextView android:layout_width="wrap_content" android:minHeight="48dp" android:paddingHorizontal="24dp" android:gravity="center" android:layout_marginTop="16dp" android:background="@drawable/cc_soft_button" android:textColor="@color/cc_primary" android:clickable="true" android:focusable="true" android:id="@+id/btnEditProfileHeader" android:layout_height="wrap_content" android:text="Edit profile" android:textSize="14sp" android:fontFamily="@font/montserrat_family" />
      </LinearLayout>
      <LinearLayout android:id="@+id/btnAccountSettings" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="76dp" android:background="@drawable/cc_card" android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp" android:layout_marginBottom="10dp" android:clickable="true" android:focusable="true" android:elevation="2dp">
        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_marginEnd="14dp" android:src="@drawable/ic_account" app:tint="@color/cc_primary" android:contentDescription="@null" />
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
          <TextView android:textStyle="bold" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Account details" android:textColor="@color/cc_text" android:textSize="14sp" android:fontFamily="@font/montserrat_family" />
          <TextView android:textColor="@color/cc_muted" android:textSize="11sp" android:layout_marginTop="5dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Profile, contact details and password" android:fontFamily="@font/montserrat_family" />
        </LinearLayout>
        <TextView android:layout_width="24dp" android:gravity="center" android:textSize="24sp" android:textColor="@color/cc_muted" android:layout_height="wrap_content" android:text="›" android:fontFamily="@font/montserrat_family" />
      </LinearLayout>
      <LinearLayout android:id="@+id/btnNotificationsCenter" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="76dp" android:background="@drawable/cc_card" android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp" android:layout_marginBottom="10dp" android:clickable="true" android:focusable="true" android:elevation="2dp">
        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_marginEnd="14dp" android:src="@drawable/cc_bell" app:tint="@color/cc_primary" android:contentDescription="@null" />
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
          <TextView android:textStyle="bold" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Notifications" android:textColor="@color/cc_text" android:textSize="14sp" android:fontFamily="@font/montserrat_family" />
          <TextView android:textColor="@color/cc_muted" android:textSize="11sp" android:layout_marginTop="5dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Your alerts and updates" android:fontFamily="@font/montserrat_family" />
        </LinearLayout>
        <TextView android:layout_width="24dp" android:gravity="center" android:textSize="24sp" android:textColor="@color/cc_muted" android:layout_height="wrap_content" android:text="›" android:fontFamily="@font/montserrat_family" />
      </LinearLayout>
      <LinearLayout android:id="@+id/btnSubscription" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="76dp" android:background="@drawable/cc_card" android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp" android:layout_marginBottom="10dp" android:clickable="true" android:focusable="true" android:elevation="2dp">
        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_marginEnd="14dp" android:src="@drawable/cc_badge" app:tint="@color/cc_primary" android:contentDescription="@null" />
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
          <TextView android:textStyle="bold" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Your subscription" android:textColor="@color/cc_text" android:textSize="14sp" android:fontFamily="@font/montserrat_family" />
          <TextView android:textColor="@color/cc_muted" android:textSize="11sp" android:layout_marginTop="5dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Plan status and payment review" android:fontFamily="@font/montserrat_family" />
        </LinearLayout>
        <TextView android:layout_width="24dp" android:gravity="center" android:textSize="24sp" android:textColor="@color/cc_muted" android:layout_height="wrap_content" android:text="›" android:fontFamily="@font/montserrat_family" />
      </LinearLayout>
      <LinearLayout android:id="@+id/btnHelp" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="76dp" android:background="@drawable/cc_card" android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp" android:layout_marginBottom="10dp" android:clickable="true" android:focusable="true" android:elevation="2dp">
        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_marginEnd="14dp" android:src="@drawable/ic_help" app:tint="@color/cc_primary" android:contentDescription="@null" />
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
          <TextView android:textStyle="bold" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Help and information" android:textColor="@color/cc_text" android:textSize="14sp" android:fontFamily="@font/montserrat_family" />
          <TextView android:textColor="@color/cc_muted" android:textSize="11sp" android:layout_marginTop="5dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Using CropCare on your farm" android:fontFamily="@font/montserrat_family" />
        </LinearLayout>
        <TextView android:layout_width="24dp" android:gravity="center" android:textSize="24sp" android:textColor="@color/cc_muted" android:layout_height="wrap_content" android:text="›" android:fontFamily="@font/montserrat_family" />
      </LinearLayout>
      <LinearLayout android:id="@+id/btnLogout" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="76dp" android:background="@drawable/cc_card" android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp" android:layout_marginBottom="10dp" android:clickable="true" android:focusable="true" android:elevation="2dp">
        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_marginEnd="14dp" android:src="@drawable/ic_logout" app:tint="@color/cc_primary" android:contentDescription="@null" />
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
          <TextView android:textStyle="bold" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Sign out" android:textColor="@color/cc_text" android:textSize="14sp" android:fontFamily="@font/montserrat_family" />
          <TextView android:textColor="@color/cc_muted" android:textSize="11sp" android:layout_marginTop="5dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Securely leave your account" android:fontFamily="@font/montserrat_family" />
        </LinearLayout>
        <TextView android:layout_width="24dp" android:gravity="center" android:textSize="24sp" android:textColor="@color/cc_muted" android:layout_height="wrap_content" android:text="›" android:fontFamily="@font/montserrat_family" />
      </LinearLayout>
    </LinearLayout>
  </ScrollView>
  <LinearLayout android:id="@+id/bottomNavContainer" android:layout_width="match_parent" android:layout_height="72dp" android:layout_marginHorizontal="36dp" android:layout_marginTop="8dp" android:layout_marginBottom="12dp" android:background="@drawable/cc_nav" android:elevation="3dp">
    <LinearLayout android:id="@+id/navHome" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackground">
      <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/cc_home" app:tint="@color/cc_muted" android:contentDescription="@null" />
      <TextView android:layout_marginTop="5dp" android:gravity="center" android:textSize="10sp" android:textColor="@color/cc_muted" android:textStyle="normal" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Home" android:fontFamily="@font/montserrat_family" />
    </LinearLayout>
    <LinearLayout android:id="@+id/navAddZone" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackground">
      <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/cc_plus" app:tint="@color/cc_muted" android:contentDescription="@null" />
      <TextView android:layout_marginTop="5dp" android:gravity="center" android:textSize="10sp" android:textColor="@color/cc_muted" android:textStyle="normal" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Add zone" android:fontFamily="@font/montserrat_family" />
    </LinearLayout>
    <LinearLayout android:id="@+id/navNotif" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackground">
      <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/cc_bell" app:tint="@color/cc_muted" android:contentDescription="@null" />
      <TextView android:layout_marginTop="5dp" android:gravity="center" android:textSize="10sp" android:textColor="@color/cc_muted" android:textStyle="normal" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Alerts" android:fontFamily="@font/montserrat_family" />
    </LinearLayout>
    <LinearLayout android:id="@+id/navSettings" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackground">
      <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/cc_settings" app:tint="@color/cc_primary" android:contentDescription="@null" />
      <TextView android:layout_marginTop="5dp" android:gravity="center" android:textSize="10sp" android:textColor="@color/cc_primary" android:textStyle="bold" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Settings" android:fontFamily="@font/montserrat_family" />
    </LinearLayout>
  </LinearLayout>
</LinearLayout>