<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#EEEEEE">

    <!-- STANDARD HEADER: reuse on other CropCare pages -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:background="@drawable/bg_dashboard_header"
        android:paddingStart="22dp" android:paddingEnd="22dp"
        android:paddingTop="20dp" android:paddingBottom="12dp" android:elevation="5dp">
        <RelativeLayout android:layout_width="match_parent" android:layout_height="42dp">
            <ImageView android:id="@+id/btnBack" android:layout_width="40dp"
                android:layout_height="40dp" android:layout_alignParentStart="true"
                android:layout_centerVertical="true" android:padding="8dp"
                android:src="@drawable/ic_back" app:tint="#FFFFFF"
                android:clickable="true" android:focusable="true"
                android:contentDescription="Back" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_centerInParent="true" android:text="Settings"
                android:textColor="#FFFFFF" android:textSize="19sp" android:textStyle="bold" />
        </RelativeLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:text="Friday, April 17, 2026"
            android:textColor="#E1F1E3" android:textSize="11sp" />
    </LinearLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:fillViewport="true" android:scrollbars="none">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingStart="28dp" android:paddingEnd="28dp"
            android:paddingTop="16dp" android:paddingBottom="20dp">

            <!-- PROFILE CARD -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:gravity="center_horizontal"
                android:background="@drawable/bg_settings_card" android:elevation="4dp"
                android:paddingTop="20dp" android:paddingBottom="14dp"
                android:paddingStart="12dp" android:paddingEnd="12dp"
                android:layout_marginBottom="26dp">
                <ImageView android:layout_width="60dp" android:layout_height="60dp"
                    android:src="@android:drawable/sym_def_app_icon"
                    android:scaleType="centerCrop" android:background="@drawable/bg_profile_circle"
                    android:clipToOutline="true" android:contentDescription="Profile picture" />
                <TextView android:id="@+id/tvProfileName" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:layout_marginTop="10dp"
                    android:text="User" android:textSize="16sp" android:textStyle="bold"
                    android:textColor="#08742D" />
                <TextView android:id="@+id/tvProfileEmail" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="user@example.com"
                    android:textSize="13sp" android:textColor="#179A45"
                    android:layout_marginBottom="16dp" />
                <TextView android:id="@+id/btnEditProfileHeader"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Edit Profile" android:textColor="#176B2C" android:textSize="11sp"
                    android:background="@drawable/bg_settings_edit_button"
                    android:paddingStart="13dp" android:paddingEnd="13dp"
                    android:paddingTop="8dp" android:paddingBottom="8dp"
                    android:clickable="true" android:focusable="true" />
            </LinearLayout>

            <!-- SETTINGS OPTIONS -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:background="@drawable/bg_settings_card"
                android:elevation="4dp" android:layout_marginBottom="30dp">
                <LinearLayout android:id="@+id/btnHelp" android:layout_width="match_parent"
                    android:layout_height="52dp" android:orientation="horizontal"
                    android:gravity="center_vertical" android:paddingStart="14dp"
                    android:paddingEnd="14dp" android:background="?attr/selectableItemBackground"
                    android:clickable="true" android:focusable="true">
                    <ImageView android:layout_width="23dp" android:layout_height="23dp"
                        android:src="@drawable/ic_help" app:tint="#161616" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginStart="17dp" android:text="Help"
                        android:textColor="#191919" android:textSize="14sp" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="#DADADA" />
                <LinearLayout android:id="@+id/btnAccountSettings" android:layout_width="match_parent"
                    android:layout_height="52dp" android:orientation="horizontal"
                    android:gravity="center_vertical" android:paddingStart="14dp"
                    android:paddingEnd="14dp" android:background="?attr/selectableItemBackground"
                    android:clickable="true" android:focusable="true">
                    <ImageView android:layout_width="23dp" android:layout_height="23dp"
                        android:src="@drawable/ic_account" app:tint="#161616" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginStart="17dp" android:text="Account Settings"
                        android:textColor="#191919" android:textSize="14sp" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="#DADADA" />
                <LinearLayout android:id="@+id/btnNotificationsCenter" android:layout_width="match_parent"
                    android:layout_height="52dp" android:orientation="horizontal"
                    android:gravity="center_vertical" android:paddingStart="14dp"
                    android:paddingEnd="14dp" android:background="?attr/selectableItemBackground"
                    android:clickable="true" android:focusable="true">
                    <ImageView android:layout_width="23dp" android:layout_height="23dp"
                        android:src="@drawable/ic_notif" app:tint="#161616" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginStart="17dp" android:text="Notifications"
                        android:textColor="#191919" android:textSize="14sp" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="#DADADA" />
                <LinearLayout android:id="@+id/btnSubscription" android:layout_width="match_parent"
                    android:layout_height="52dp" android:orientation="horizontal"
                    android:gravity="center_vertical" android:paddingStart="14dp"
                    android:paddingEnd="14dp" android:background="?attr/selectableItemBackground"
                    android:clickable="true" android:focusable="true">
                    <ImageView android:layout_width="23dp" android:layout_height="23dp"
                        android:src="@android:drawable/ic_menu_agenda" app:tint="#161616" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginStart="17dp" android:text="Subscription &amp; Membership"
                        android:textColor="#191919" android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- LOG OUT -->
            <LinearLayout android:id="@+id/btnLogout"
                android:layout_width="match_parent" android:layout_height="54dp"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:paddingStart="15dp" android:paddingEnd="15dp"
                android:background="@drawable/bg_settings_card" android:elevation="4dp"
                android:clickable="true" android:focusable="true">
                <ImageView android:layout_width="24dp" android:layout_height="24dp"
                    android:src="@drawable/ic_logout" app:tint="#FF3030" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="18dp" android:text="Log out"
                    android:textColor="#FF3030" android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- STANDARD FLOATING NAVIGATION: same IDs and view types -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:gravity="center"
        android:paddingStart="42dp" android:paddingEnd="42dp"
        android:paddingTop="6dp" android:paddingBottom="10dp" android:background="#EEEEEE">
        <LinearLayout android:id="@+id/bottomNavContainer"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:weightSum="4"
            android:paddingTop="7dp" android:paddingBottom="5dp"
            android:background="@drawable/bg_cropcare_bottom_nav" android:elevation="6dp">
            <LinearLayout android:id="@+id/navHome" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:orientation="vertical" android:gravity="center"
                android:padding="2dp" android:background="?attr/selectableItemBackground"
                android:clickable="true" android:focusable="true">
                <ImageView android:layout_width="22dp" android:layout_height="22dp"
                    android:src="@drawable/ic_home" app:tint="#111111" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Home" android:textSize="11sp" android:textColor="#111111" />
            </LinearLayout>
            <LinearLayout android:id="@+id/navAddZone" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:orientation="vertical" android:gravity="center"
                android:padding="2dp" android:background="?attr/selectableItemBackground"
                android:clickable="true" android:focusable="true">
                <ImageView android:layout_width="22dp" android:layout_height="22dp"
                    android:src="@drawable/ic_add" app:tint="#111111" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Add Zone" android:textSize="11sp" android:textColor="#111111" />
            </LinearLayout>
            <LinearLayout android:id="@+id/navNotif" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:orientation="vertical" android:gravity="center"
                android:padding="2dp" android:background="?attr/selectableItemBackground"
                android:clickable="true" android:focusable="true">
                <FrameLayout android:layout_width="26dp" android:layout_height="23dp">
                    <ImageView android:layout_width="22dp" android:layout_height="22dp"
                        android:layout_gravity="start|bottom" android:src="@drawable/ic_notif"
                        app:tint="#111111" />
                    <TextView android:layout_width="15dp" android:layout_height="15dp"
                        android:layout_gravity="top|end" android:text="1"
                        android:textColor="#FFFFFF" android:textSize="9sp" android:gravity="center"
                        android:background="@drawable/bg_settings_notif_badge" />
                </FrameLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Notify" android:textSize="11sp" android:textColor="#111111" />
            </LinearLayout>
            <LinearLayout android:id="@+id/navSettings" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:orientation="vertical" android:gravity="center"
                android:padding="2dp" android:background="?attr/selectableItemBackground"
                android:clickable="true" android:focusable="true">
                <ImageView android:layout_width="22dp" android:layout_height="22dp"
                    android:src="@drawable/ic_settings" app:tint="#176B2C" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Settings" android:textSize="11sp" android:textColor="#176B2C" android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
