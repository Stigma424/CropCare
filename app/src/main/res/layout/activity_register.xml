<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/cc_auth_background" android:fillViewport="true">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp" android:gravity="top">
    <TextView android:textSize="30sp" android:textStyle="bold" android:textColor="@color/cc_primary_dark" android:layout_marginBottom="8dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Register" android:fontFamily="@font/montserrat_family" android:gravity="center" android:layout_marginTop="32dp" android:letterSpacing="0.12" />
    <TextView android:textColor="@color/cc_muted" android:lineSpacingExtra="4dp" android:layout_marginBottom="32dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Create your account to get started" android:textSize="14sp" android:fontFamily="@font/montserrat_family" android:gravity="center" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@android:color/transparent" android:padding="0dp">
      <EditText android:id="@+id/etFirstName" android:layout_width="match_parent" android:layout_height="56dp" android:background="@drawable/cc_input" android:paddingHorizontal="16dp" android:textSize="14sp" android:textColor="@color/cc_text" android:textColorHint="@color/cc_muted" android:hint="First name" android:inputType="textPersonName" android:layout_marginBottom="12dp" android:fontFamily="@font/montserrat_family" android:minHeight="52dp" android:paddingStart="16dp" android:paddingEnd="16dp" />
      <EditText android:id="@+id/etLastName" android:layout_width="match_parent" android:layout_height="56dp" android:background="@drawable/cc_input" android:paddingHorizontal="16dp" android:textSize="14sp" android:textColor="@color/cc_text" android:textColorHint="@color/cc_muted" android:hint="Last name" android:inputType="textPersonName" android:layout_marginBottom="12dp" android:fontFamily="@font/montserrat_family" android:minHeight="52dp" android:paddingStart="16dp" android:paddingEnd="16dp" />
      <EditText android:id="@+id/etAddress" android:layout_width="match_parent" android:layout_height="56dp" android:background="@drawable/cc_input" android:paddingHorizontal="16dp" android:textSize="14sp" android:textColor="@color/cc_text" android:textColorHint="@color/cc_muted" android:hint="Address" android:inputType="textPostalAddress" android:layout_marginBottom="12dp" android:fontFamily="@font/montserrat_family" android:minHeight="52dp" android:paddingStart="16dp" android:paddingEnd="16dp" />
      <EditText android:id="@+id/etUsername" android:layout_width="match_parent" android:layout_height="56dp" android:background="@drawable/cc_input" android:paddingHorizontal="16dp" android:textSize="14sp" android:textColor="@color/cc_text" android:textColorHint="@color/cc_muted" android:hint="Username" android:inputType="text" android:layout_marginBottom="12dp" android:fontFamily="@font/montserrat_family" android:minHeight="52dp" android:paddingStart="16dp" android:paddingEnd="16dp" />
      <EditText android:id="@+id/etEmail" android:layout_width="match_parent" android:layout_height="56dp" android:background="@drawable/cc_input" android:paddingHorizontal="16dp" android:textSize="14sp" android:textColor="@color/cc_text" android:textColorHint="@color/cc_muted" android:hint="Email address" android:inputType="textEmailAddress" android:layout_marginBottom="12dp" android:fontFamily="@font/montserrat_family" android:minHeight="52dp" android:paddingStart="16dp" android:paddingEnd="16dp" />
      <FrameLayout android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginBottom="12dp">
        <EditText android:id="@+id/etPassword" android:layout_width="match_parent" android:layout_height="56dp" android:background="@drawable/cc_input" android:paddingHorizontal="16dp" android:textSize="14sp" android:textColor="@color/cc_text" android:textColorHint="@color/cc_muted" android:hint="Password (8–128 characters)" android:inputType="textPassword" android:layout_marginBottom="12dp" android:saveEnabled="false" android:paddingEnd="60dp" android:fontFamily="@font/montserrat_family" android:minHeight="52dp" android:paddingStart="16dp" />
        <ImageView android:id="@+id/ivTogglePassword1" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="end|center_vertical" android:layout_marginEnd="4dp" android:src="@drawable/cc_eye" android:padding="13dp" android:contentDescription="Show password" android:clickable="true" android:focusable="true" app:tint="@color/cc_primary" />
      </FrameLayout>
      <FrameLayout android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginBottom="12dp">
        <EditText android:id="@+id/etConfirmPassword" android:layout_width="match_parent" android:layout_height="56dp" android:background="@drawable/cc_input" android:paddingHorizontal="16dp" android:textSize="14sp" android:textColor="@color/cc_text" android:textColorHint="@color/cc_muted" android:hint="Confirm password" android:inputType="textPassword" android:layout_marginBottom="12dp" android:saveEnabled="false" android:paddingEnd="60dp" android:fontFamily="@font/montserrat_family" android:minHeight="52dp" android:paddingStart="16dp" />
        <ImageView android:id="@+id/ivTogglePassword2" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="end|center_vertical" android:layout_marginEnd="4dp" android:src="@drawable/cc_eye" android:padding="13dp" android:contentDescription="Show password" android:clickable="true" android:focusable="true" app:tint="@color/cc_primary" />
      </FrameLayout>
      <TextView android:id="@+id/btnRegister" android:layout_width="match_parent" android:layout_height="52dp" android:gravity="center" android:text="Create account" android:textSize="14sp" android:textStyle="bold" android:textAllCaps="false" android:textColor="@color/white" android:background="@drawable/bg_login_button" android:clickable="true" android:focusable="true" android:layout_marginTop="8dp" android:layout_marginBottom="8dp" android:fontFamily="@font/montserrat_family" />
      <TextView android:id="@+id/btnBack" android:layout_width="match_parent" android:layout_height="52dp" android:gravity="center" android:text="Back to sign in" android:textSize="14sp" android:textStyle="bold" android:textAllCaps="false" android:textColor="@color/cc_primary" android:background="@drawable/cc_soft_button" android:clickable="true" android:focusable="true" android:layout_marginTop="8dp" android:layout_marginBottom="8dp" android:fontFamily="@font/montserrat_family" />
    </LinearLayout>
  </LinearLayout>
</ScrollView>