<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#EAEAEA">

    <!-- GREEN HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="78dp"
        android:orientation="vertical"
        android:paddingTop="12dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="@drawable/bg_zone_header">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="34dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="Add Zone"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold"
                android:gravity="center"/>

            <TextView
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="match_parent"
                android:text="‹"
                android:textColor="#FFFFFF"
                android:textSize="32sp"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"/>

        </FrameLayout>

        <TextView
            android:id="@+id/tvCurrentDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Friday, April 17, 2026"
            android:textColor="#DCE9DC"
            android:textSize="10sp"
            android:layout_marginTop="5dp"/>

    </LinearLayout>

    <!-- SCROLLABLE CONTENT -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:padding="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="12dp"
            android:padding="18dp"
            android:elevation="4dp"
            android:background="@drawable/bg_zone_card">

            <!-- ZONE NAME -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Enter Zone Name"
                android:textColor="#444444"
                android:textSize="12sp"
                android:layout_marginBottom="10dp"/>

            <EditText
                android:id="@+id/etZoneName"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:background="@drawable/bg_zone_input"
                android:hint="e.g., Mais 3"
                android:textSize="12sp"
                android:textColor="#333333"
                android:textColorHint="#BDBDBD"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:inputType="text"
                android:singleLine="true"/>

            <!-- ZONE AREA -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Enter Zone Area per Square Meter"
                android:textColor="#444444"
                android:textSize="12sp"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="10dp"/>

            <EditText
                android:id="@+id/etZoneArea"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:background="@drawable/bg_zone_input"
                android:hint="e.g., 500"
                android:textSize="12sp"
                android:textColor="#333333"
                android:textColorHint="#BDBDBD"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:inputType="numberDecimal"
                android:singleLine="true"/>

            <!-- PLANTING DATE -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="When did you start planting?"
                android:textColor="#444444"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="14dp"/>

            <!-- CALENDAR HEADER -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnPreviousMonth"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:gravity="center"
                    android:text="‹"
                    android:textSize="20sp"
                    android:textColor="#222222"
                    android:background="@drawable/bg_calendar_arrow"/>

                <TextView
                    android:id="@+id/tvCalendarMonth"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="April"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#111111"
                    android:gravity="center"/>

                <TextView
                    android:id="@+id/btnNextMonth"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:gravity="center"
                    android:text="›"
                    android:textSize="20sp"
                    android:textColor="#222222"
                    android:background="@drawable/bg_calendar_arrow"/>

            </LinearLayout>

            <!-- WEEKDAYS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="35dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Mon"
                    android:gravity="center"
                    android:textSize="10sp"
                    android:textColor="#999999"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Tue"
                    android:gravity="center"
                    android:textSize="10sp"
                    android:textColor="#999999"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Wed"
                    android:gravity="center"
                    android:textSize="10sp"
                    android:textColor="#999999"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Thu"
                    android:gravity="center"
                    android:textSize="10sp"
                    android:textColor="#999999"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Fri"
                    android:gravity="center"
                    android:textSize="10sp"
                    android:textColor="#999999"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Sat"
                    android:gravity="center"
                    android:textSize="10sp"
                    android:textColor="#999999"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Sun"
                    android:gravity="center"
                    android:textSize="10sp"
                    android:textColor="#999999"/>

            </LinearLayout>

            <!-- CALENDAR DAYS GENERATED IN KOTLIN -->
            <GridLayout
                android:id="@+id/calendarGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="7"
                android:rowCount="6"
                android:alignmentMode="alignMargins"
                android:useDefaultMargins="false"/>

            <!-- PRESERVED PLANTING DATE FIELD -->
            <EditText
                android:id="@+id/etPlantingDate"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:visibility="gone"
                android:focusable="false"
                android:inputType="date"/>

            <!-- ACTION BUTTONS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="12dp">

                <Button
                    android:id="@+id/btnCancel"
                    android:layout_width="90dp"
                    android:layout_height="40dp"
                    android:text="Cancel"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    android:textColor="#286B2D"
                    android:backgroundTint="#E8F4E8"
                    android:layout_marginEnd="16dp"/>

                <Button
                    android:id="@+id/btnAddZoneSubmit"
                    android:layout_width="90dp"
                    android:layout_height="40dp"
                    android:text="Add"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#286B2D"/>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- BOTTOM NAVIGATION -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="12dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:elevation="6dp"
        android:background="@drawable/bg_zone_bottom_nav">

        <TextView
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="⌂\nHome"
            android:textSize="13sp"
            android:textColor="#111111"/>

        <TextView
            android:id="@+id/navAddZone"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="+\nAdd Zone"
            android:textSize="13sp"
            android:textColor="#286B2D"/>

        <TextView
            android:id="@+id/navNotify"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="♧\nNotify"
            android:textSize="13sp"
            android:textColor="#111111"/>

        <TextView
            android:id="@+id/navSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="⚙\nSettings"
            android:textSize="13sp"
            android:textColor="#111111"/>

    </LinearLayout>

</LinearLayout>
