<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add New Zone"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <EditText
            android:id="@+id/etZoneName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Zone Name"
            android:inputType="text"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/etZoneArea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Area (sq. meters)"
            android:inputType="numberDecimal"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/etPlantingDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Date of Planting (Tap to select)"
            android:focusable="false"
            android:clickable="true"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnAddZoneSubmit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add Zone"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnBack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Back"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

    </LinearLayout>
</ScrollView>