<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/cc_auth_background" android:fillViewport="true">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp" android:gravity="center_vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:layout_marginBottom="64dp" android:layout_marginTop="12dp">
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="CROPCARE" android:textSize="30sp" android:textStyle="bold" android:letterSpacing="0.12" android:textColor="#126616" android:fontFamily="@font/montserrat_family"/>
      <TextView android:gravity="center" android:textColor="@color/cc_primary" android:textSize="10sp" android:letterSpacing="0.16" android:layout_marginTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="SMART FARMING" android:fontFamily="@font/montserrat_family" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/cc_login_card" android:elevation="4dp" android:padding="20dp">
      <TextView android:textSize="27sp" android:textStyle="bold" android:textColor="@color/cc_primary_dark" android:layout_marginBottom="8dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Welcome back" android:fontFamily="@font/montserrat_family" />
      <TextView android:textColor="@color/cc_muted" android:lineSpacingExtra="4dp" android:layout_marginBottom="24dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Sign in to continue to CropCare" android:textSize="14sp" android:fontFamily="@font/montserrat_family" />

      <EditText android:id="@+id/etLoginUsername" android:layout_width="match_parent" android:layout_height="56dp" android:background="@drawable/cc_input" android:paddingHorizontal="16dp" android:textSize="14sp" android:textColor="@color/cc_text" android:textColorHint="@color/cc_muted" android:hint="Username or email" android:inputType="text" android:layout_marginBottom="12dp" android:fontFamily="@font/montserrat_family" android:minHeight="52dp" android:paddingStart="16dp" android:paddingEnd="16dp" />

      <FrameLayout android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginBottom="12dp">
        <EditText android:id="@+id/etLoginPassword" android:layout_width="match_parent" android:layout_height="56dp" android:background="@drawable/cc_input" android:paddingHorizontal="16dp" android:textSize="14sp" android:textColor="@color/cc_text" android:textColorHint="@color/cc_muted" android:hint="Password" android:inputType="textPassword" android:layout_marginBottom="12dp" android:saveEnabled="false" android:paddingEnd="60dp" android:fontFamily="@font/montserrat_family" android:minHeight="52dp" android:paddingStart="16dp" />
        <ImageView android:id="@+id/ivTogglePassword" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="end|center_vertical" android:layout_marginEnd="4dp" android:src="@drawable/cc_eye" android:padding="13dp" android:contentDescription="Show password" android:clickable="true" android:focusable="true" app:tint="@color/cc_primary" />
      </FrameLayout>
      <TextView android:id="@+id/tvForgotPassword" android:textColor="@color/cc_primary" android:gravity="end|center_vertical" android:minHeight="48dp" android:clickable="true" android:focusable="true" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Forgot password?" android:textSize="14sp" android:fontFamily="@font/montserrat_family" />
      <TextView android:id="@+id/btnLogin" android:layout_width="match_parent" android:layout_height="52dp" android:gravity="center" android:text="LOGIN" android:letterSpacing="0.25" android:textSize="14sp" android:textStyle="bold" android:textAllCaps="false" android:textColor="@color/white" android:background="@drawable/cc_login_primary" android:clickable="true" android:focusable="true" android:layout_marginTop="8dp" android:layout_marginBottom="8dp" android:fontFamily="@font/montserrat_family" />
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="OR" android:textSize="12sp" android:textColor="#9A9E9A" android:layout_marginVertical="16dp"/><TextView android:gravity="center" android:textColor="@color/cc_muted" android:layout_marginTop="16dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Don’t have an account?" android:textSize="14sp" android:fontFamily="@font/montserrat_family" />
      <TextView android:id="@+id/tvRegister" android:layout_width="match_parent" android:layout_height="52dp" android:gravity="center" android:text="Register" android:textSize="14sp" android:textStyle="bold" android:textAllCaps="false" android:textColor="@color/cc_primary" android:background="@drawable/cc_login_secondary" android:clickable="true" android:focusable="true" android:layout_marginTop="8dp" android:layout_marginBottom="8dp" android:fontFamily="@font/montserrat_family" />
    </LinearLayout>
  </LinearLayout>
</ScrollView>